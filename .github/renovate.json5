{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'github>cert-manager/makefile-modules:renovate-config.json5'
  ],
  baseBranchPatterns: [
    'master',
    'release-1.20',
    'release-1.21',
  ],
  addLabels: [
    'kind/cleanup',
    'release-note-none',
  ],
  customManagers: [
    {
      customType: 'regex',
      managerFilePatterns: [
        'make/base_images.mk',
      ],
      matchStrings: [
        '(?<depName>gcr\\.io\/[^@]+)@(?<currentDigest>sha256:[a-f0-9]{64})',
      ],
      datasourceTemplate: 'docker',
      // this tag must match the tag used in hack/latest-base-images.sh
      currentValueTemplate: 'nonroot'
    },
    {
      customType: 'regex',
      managerFilePatterns: [
        'hack/latest-kgateway-images.sh',
        'hack/latest-kind-images.sh',
        'make/02_mod.mk',
        'make/_shared/tools/00_mod.mk',
      ],
      matchStrings: [
        "#\\s*renovate:\\s*datasource=(?<datasource>\\S+)\\s+packageName=(?<packageName>\\S+)\\s*\\n(?<varName>[A-Za-z0-9_]+)\\s*(?::=|\\?=|=)\\s*(?<currentValue>\\S+)"
      ]
    },
  ],
  packageRules: [
    {
      description: 'Ungroup all updates on release branches',
      matchBaseBranches: [
        '/^release-.*/',
      ],
      groupName: null,
    },
    {
      groupName: 'Base Images',
      matchManagers: [
        'custom.regex',
      ],
      matchFileNames: [
        'make/base_images.mk',
      ],
      addLabels: [
        'skip-review', // Adding label to allow PRs to automerge
      ],
    },
    {
      groupName: null,
      matchManagers: [
        'custom.regex',
      ],
      matchPackageNames: [
        'kubernetes-sigs/kind',
      ],
      postUpgradeTasks: {
        commands: [
          'hack/latest-kind-images.sh',
        ],
      },
    },
    {
      groupName: null,
      matchManagers: [
        'custom.regex',
      ],
      matchPackageNames: [
        'cr.kgateway.dev/kgateway-dev/charts/kgateway',
      ],
      postUpgradeTasks: {
        commands: [
          'hack/latest-kgateway-images.sh',
        ],
      },
    },
    {
      description: 'Ignore updates in general on release branches',
      matchBaseBranches: [
        '/^release-.*/',
      ],
      enabled: false,
    },
    {
      description: 'Enable base image updates on release branches',
      matchBaseBranches: [
        '/^release-.*/',
      ],
      matchFileNames: [
        'make/base_images.mk',
      ],
      enabled: true,
    },
    {
      description: 'make/_shared is synced from makefile-modules by klone, so do not update it directly',
      matchFileNames: [
        'make/_shared/**',
      ],
      enabled: false,
    },
    {
      description: 'Enable Go updates on release branches. A rule that matches an update type is applied after lookup, so it cannot re-enable a dependency; the minor and major updates are disabled by the next rule instead.',
      matchBaseBranches: [
        '/^release-.*/',
      ],
      matchFileNames: [
        'make/_shared/tools/00_mod.mk',
      ],
      matchDatasources: [
        'golang-version',
      ],
      enabled: true,
      separateMinorPatch: true,
      postUpgradeTasks: {
        commands: [
          'hack/learn-go-shas.sh',
        ],
        executionMode: 'branch',
      },
    },
    {
      description: 'Keep the Go minor version of each release branch',
      matchBaseBranches: [
        '/^release-.*/',
      ],
      matchDatasources: [
        'golang-version',
      ],
      matchUpdateTypes: [
        'minor',
        'major',
      ],
      enabled: false,
    },
  ],
  // The shared preset ignores make/_shared/**. Override it so that the Go
  // version in the tools module can be updated on release branches.
  ignorePaths: [
    '**/vendor/**',
    '.github/workflows/govulncheck.yaml',
  ],
}
